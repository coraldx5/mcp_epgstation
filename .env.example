# mcp_epgstation backend
HOST_PORT=3001
PORT=3001
EPGSTATION_URL=http://192.168.0.31:8888/api

# mcp-auth-proxy image
# The Docker Hub image psethi/mcp-auth-proxy:v0.0.1 does not expose the
# Google/OIDC options required for this setup, so the stack defaults to the
# upstream image that supports OAuth/OIDC providers.
MCP_AUTH_PROXY_IMAGE=ghcr.io/sigbit/mcp-auth-proxy:latest

# Public URL exposed to MCP clients. Must be pathless.
# For ChatGPT / Google / Keycloak production use, set this to your HTTPS domain.
EXTERNAL_URL=https://mcp.example.com

# Run TLS outside the container (for example with an HTTPS reverse proxy).
NO_AUTO_TLS=true
LISTEN=:80
NO_PROVIDER_AUTO_SELECT=true
HTTP_STREAMING_ONLY=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Safe default: replace before enabling Google sign-in.
GOOGLE_ALLOWED_USERS=change-me@example.com
GOOGLE_ALLOWED_WORKSPACES=

# Keycloak via generic OIDC
OIDC_PROVIDER_NAME=Keycloak
OIDC_CONFIGURATION_URL=https://keycloak.example.com/realms/your-realm/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email
OIDC_USER_ID_FIELD=/email
# Safe default: replace before enabling Keycloak sign-in.
OIDC_ALLOWED_USERS=change-me@example.com
OIDC_ALLOWED_USERS_GLOB=
OIDC_ALLOWED_ATTRIBUTES=
OIDC_ALLOWED_ATTRIBUTES_GLOB=

# Optional proxy settings
TRUSTED_PROXIES=
PROXY_FORWARD_AUTHORIZATION=false
